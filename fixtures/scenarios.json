        "status": 200,
        "method": "GET"
      },
      {
        "path": "/part/2",
        "body": "chr1\tX\tCDS\t30\t40\t.\t+\t2\tID=c1;Parent=t1,t2\nchr1\tX\tmRNA\t1\t80\t.\t+\t.\tID=t1\nchr1\tX\tmRNA\t1\t90\t.\t+\t.\tID=t2\n",
        "status": 200,
        "method": "GET"
      }
    ],
    "expected": [
